<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="<%= style %>">
  <title>
    <%= title %>
  </title>
</head>

<body>
  <main class="pl-10 pr-10 pt-10 pb-10">
    <div class="text-center pb-10">
      <img width="100" src="<%= empresa.rutaLogo ?? icon %>" class="mb-5" />
      <br />
      <h2 class="font-weight-bold text-uppercase">
        <%= empresa.nombreEmpresa %>
      </h2>
      <p>RUC: <%= empresa.documento %>
      </p>
      <p>
        <%= sucursal.direccion %>
      </p>
      <p>
        <%= sucursal.ubigeo.departamento %> - <%= sucursal.ubigeo.provincia %> - <%= sucursal.ubigeo.distrito %>
      </p>
      <p>Telf.: <%= sucursal.telefono %>
      </p>
      <p>Cel.: <%= sucursal.celular %>
      </p>
      <p>
        <%= sucursal.email %>
      </p>
      <p>
        <%= empresa.paginaWeb %>
      </p>
    </div>

    <div class="border-1 border-dashed"></div>

    <div class="text-center pt-5 pb-5">
      <p class="font-weight-bold text-uppercase font-size-13">
        <%= guiaRemision.comprobante.nombre %>
      </p>
      <p class="font-weight-bold font-size-13">
        <%= guiaRemision.comprobante.serie %>-<%= guiaRemision.comprobante.numeracion %>
      </p>
    </div>

    <div class="pt-5 pb-5">
      <p><span class="font-weight-bold">Fecha de Traslado: </span>
        <%= guiaRemision.fecha %>
          <%= guiaRemision.hora %>
      </p>
      <p><span class="font-weight-bold">Doc. Relacionado:</span>
        <%= guiaRemision.venta.comprobante.nombre %>
          <%= guiaRemision.venta.comprobante.serie %>-<%= guiaRemision.venta.comprobante.numeracion %>
      </p>
      <p><span class="font-weight-bold">RUC / DNI:</span>
        <%= guiaRemision.venta.cliente.documento %>
      </p>
      <p><span class="font-weight-bold">Destinatario:</span>
        <%= guiaRemision.venta.cliente.informacion %>
      </p>

      <p><span class="font-weight-bold">Dirección de Partida:</span>
        <%= guiaRemision.direccionPartida %>
      </p>
      <p><span class="font-weight-bold">Dirección de Llegada:</span>
        <%= guiaRemision.direccionLlegada %>
      </p>

      <p><span class="font-weight-bold">Transportista</span></p>
      <p><span class="font-weight-bold">Apellidos y Nombres:</span>
        <%= guiaRemision.conductor.informacion %>
      </p>
      <p><span class="font-weight-bold">RUC / DNI:</span>
        <%= guiaRemision.conductor.documento %>
      </p>
      <p><span class="font-weight-bold">Modalidad Traslado:</span>
        <%= guiaRemision.modalidadTraslado.nombre %>
      </p>

      <p><span class="font-weight-bold">Unidad de Transporte</span> </p>
      <p><span class="font-weight-bold">Licencia de Conducir:</span>
        <%= guiaRemision.conductor.licenciaConducir %>
      </p>
      <p><span class="font-weight-bold">Número de Placa:</span>
        <%= guiaRemision.vehiculo.numeroPlaca %>
      </p>
      <p><span class="font-weight-bold">Motivo Traslado:</span>
        <%= guiaRemision.motivoTraslado.nombre %>
      </p>
    </div>

    <div class="border-1 border-dashed"></div>

    <div>
      <table class="table">
        <thead>
          <tr>
            <th width="5%" class="text-center">
              <p>#</p>
            </th>
            <th width="30%" class="text-center">
              <p>Producto</p>
            </th>
            <th width="10%" class="text-center">
              <p>Uni.</p>
            </th>
            <th width="10%" class="text-right">
              <p>Cantidad</p>
            </th>
          </tr>
        </thead>
        <tbody>
          <% for (const item of detalles) { %>
            <tr>
              <td class="text-center">
                <p>
                  <%= item.id %>
                </p>
              </td>
              <td class="text-left">
                <p>
                  <%= item.producto.nombre %>
                </p>
              </td>
              <td class="text-center">
                <p>
                  <%= item.producto.medida.nombre %>
                </p>
              </td>
              <td class="text-right">
                <p>
                  <%= formatDecimal(item.cantidad) %>
                </p>
              </td>
            </tr>
            <% } %>
        </tbody>
      </table>
    </div>

    <div class="border-1 border-dashed"></div>

    <footer class="pt-5">
      <div class="text-center mb-5">
        <p>Vendedor: <%= guiaRemision.usuario.nombres %>, <%= guiaRemision.usuario.apellidos %>
        </p>
      </div>

      <div class="text-center">
        <% if (guiaRemision.comprobante.facturado) { %>
          <p class="font-weight-bold text-center">
            Representación Impresa de la guía de remisión Electrónica.
          </p>
          <img src="data:image/png;base64,<%= base64QR %>" alt="QR Code" width="100" />
          <br />
          <a href="https://ww1.sunat.gob.pe/ol-ti-itconsultaunificadalibre/consultaUnificadaLibre/consulta">
            www.consultas-sunat.com
          </a>
          <% } %>
      </div>

      <div class="text-center mt-2">
        <img src="<%= icon %>" width="40" class="m-0">
        <br />
        <a href="https://www.syssoftintegra.com/" class="font-family-pacifico">
          Emitido por: <span class="font-weight-bold">www.syssosftintegra.com</span>
        </a>
      </div>

      <% if (empresa.tipoEnvio===0) { %>
        <p class="text-danger font-weight-bold text-center">
          Documento no valido
        </p>
        <% } %>
    </footer>
  </main>
</body>

</html>